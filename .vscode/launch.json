    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'termul'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=termul"
                ],
                "filter": {
                    "name": "termul",
                    "kind": "bin"
                }
            },
            "cwd": "${workspaceFolder}",
            "terminal": "integrated",
            "args": []
        },
        {
            "name": "Debug unit tests in executable 'termul'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=termul"
                ]
            }
        }
    ]
}